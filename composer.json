{
    "name": "fooino/skeleton",
    "description": "The fooino skeleton package with tools and functionalities.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Sajad Sholi",
            "email": "sajadsholidev@gmail.com",
            "role": "owner"
        }
    ],
    "keywords": [
        "laravel",
        "fooino",
        "skeleton"
    ],
    "require": {
        "php": "^8.5",
        "fooino/core": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-type-coverage": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Fooino\\Skeleton\\": "src/",
            "Fooino\\Skeleton\\Database\\": "database/",
            "Fooino\\Skeleton\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Fooino\\Skeleton\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fooino\\Skeleton\\Providers\\SkeletonServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "pest": "./vendor/bin/pest",
        "pest:coverage": "./vendor/bin/pest --coverage",
        "pest:coverage:html": "./vendor/bin/pest --coverage-html coverage",
        "pest:coverage:type": "./vendor/bin/pest --type-coverage"
    }
}
